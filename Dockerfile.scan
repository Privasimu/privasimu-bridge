# syntax=docker/dockerfile:1
#
# privasimu-bridge:<version>-scan: the bridge plus pinned Syft and Grype, for the agent job
# scan_packages. The default image (Dockerfile) stays unchanged and has no scanner.
#
# Base images are pinned by digest (the same as Dockerfile). Syft and Grype are pinned by
# version and by the SHA-256 of their release archives, taken from the official checksums
# files of each release (syft_<v>_checksums.txt, grype_<v>_checksums.txt, which Anchore
# signs with Sigstore). The build refuses an archive whose checksum differs. Update the
# version and both checksums together. The SHA-256 of the extracted executables is written
# to /opt/privasimu-bridge/tools/SHA256SUMS for packages.tools in bridge.yaml:
#
#   docker build -f Dockerfile.scan -t privasimu-bridge:0.3.0-scan --build-arg VERSION=0.3.0 .
#   id=$(docker create privasimu-bridge:0.3.0-scan)
#   docker cp "$id:/opt/privasimu-bridge/tools/SHA256SUMS" - | tar -xO; docker rm "$id"
#
# No vulnerability database is baked in: it must stay current. Let Grype download it
# (packages.tools.grype.db_auto_update: true, optionally from db_update_url, a mirror in
# your network) or import one into the state volume (docs/INSTALL.en.md, section 11.1).

FROM golang:1.26.10-bookworm@sha256:23ce71337b726608afb1bc00986e630a05034a87a87ea1fc2cd1ae5cf33387eb AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY cmd ./cmd
COPY internal ./internal
ARG VERSION=0.1.0-dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
      -ldflags "-s -w -X github.com/privasimu/bridge/internal/buildinfo.Version=${VERSION} -X github.com/privasimu/bridge/internal/buildinfo.Commit=${COMMIT}" \
      -o /out/privasimu-bridge ./cmd/privasimu-bridge

FROM golang:1.26.10-bookworm@sha256:23ce71337b726608afb1bc00986e630a05034a87a87ea1fc2cd1ae5cf33387eb AS tools
ARG TARGETARCH
# Syft v1.55.0 and Grype v0.121.0, released 19 October 2026.
ARG SYFT_VERSION=1.55.0
ARG SYFT_SHA256_AMD64=bb65249542db5fedeeb4d3f9b018b75e7264dbfbbb10486f044581a92f90490d
ARG SYFT_SHA256_ARM64=929bd163db2d7cd2255d3bcb8967208079813d7b46b0c952f7b794d8e2c7d304
ARG GRYPE_VERSION=0.121.0
ARG GRYPE_SHA256_AMD64=64e07133d3486115de647a66581461dccf5c732748a0a3119077395565f15519
ARG GRYPE_SHA256_ARM64=86f570f75ca947ea3dd6486309232bcff6d78e44ba081ae75ab14eab72be3dae
WORKDIR /tools
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) syft_sum="$SYFT_SHA256_AMD64"; grype_sum="$GRYPE_SHA256_AMD64"; arch=amd64 ;; \
      arm64) syft_sum="$SYFT_SHA256_ARM64"; grype_sum="$GRYPE_SHA256_ARM64"; arch=arm64 ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --proto '=https' --tlsv1.2 -o syft.tar.gz \
      "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_${arch}.tar.gz"; \
    echo "${syft_sum}  syft.tar.gz" | sha256sum -c -; \
    curl -fsSL --proto '=https' --tlsv1.2 -o grype.tar.gz \
      "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_${arch}.tar.gz"; \
    echo "${grype_sum}  grype.tar.gz" | sha256sum -c -; \
    mkdir out; \
    tar -xzf syft.tar.gz -C out syft; \
    tar -xzf grype.tar.gz -C out grype; \
    chmod 0555 out/syft out/grype; \
    cd out && sha256sum syft grype > SHA256SUMS && chmod 0444 SHA256SUMS && cat SHA256SUMS

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/privasimu-bridge /usr/local/bin/privasimu-bridge
# Owned by root and read-only for the bridge's user, as packages.tools expects.
COPY --from=tools --chown=0:0 /tools/out/ /opt/privasimu-bridge/tools/
# 65532 is the "nonroot" user of the distroless image.
USER 65532:65532
ENV PRIVASIMU_BRIDGE_CONFIG=/etc/privasimu-bridge/bridge.yaml
VOLUME ["/var/lib/privasimu-bridge"]
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD ["/usr/local/bin/privasimu-bridge", "healthcheck", "--mode", "agent"]
ENTRYPOINT ["/usr/local/bin/privasimu-bridge"]
# Package scans are a mode B job.
CMD ["agent"]
