# Build output
/dist/
/bin/
/privasimu-bridge
/privasimu-bridge.exe
*.exe
*.test
*.out
coverage.*

# Local runtime data: never commit configuration with key hashes, secrets or reports
/data/
/local/
*.local.yaml
secrets.enc
secrets.key
# Release signing: only the public keys in release-keys/ belong here (docs/RELEASE-SIGNING.md)
cosign.key
minisign.key
*.minisign.key
release-keys/*
!release-keys/minisign.pub
!release-keys/cosign.pub
*.pem
*.key
*.crt
!internal/**/testdata/**/*.pem

# Editors and OS files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
